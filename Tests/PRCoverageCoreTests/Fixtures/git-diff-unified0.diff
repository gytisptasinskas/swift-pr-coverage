diff --git a/Example/Core/Sources/PriceFormatter.swift b/Example/Core/Sources/PriceFormatter.swift
index 9b50a7a..fd32e78 100644
--- a/Example/Core/Sources/PriceFormatter.swift
+++ b/Example/Core/Sources/PriceFormatter.swift
@@ -3 +3 @@ import Foundation
-/// Formats prices.
+/// Partly covered: `format` is tested, `discounted` and the `.free` branch are not.
@@ -28,0 +29,17 @@ public struct PriceFormatter {
+
+    public func discounted(cents: Int, percent: Int) -> Int {
+        let clamped = min(max(percent, 0), 100)
+        let values = [cents].map { value in
+            value - value * clamped / 100
+        }
+        return values[0]
+    }
+
+    public func bundledGreeting() -> String? {
+        guard let url = Bundle.module.url(forResource: "greeting", withExtension: "json"),
+              let data = try? Data(contentsOf: url)
+        else {
+            return nil
+        }
+        return String(data: data, encoding: .utf8)
+    }
